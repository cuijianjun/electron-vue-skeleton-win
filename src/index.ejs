<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>我的应用</title>
  <% if (htmlWebpackPlugin.options.nodeModules) { %>
    <!-- 开发环境下把 node_modules 加入全局路径，保证 require 可用 -->
    <script>
      require('module').globalPaths.push('<%= htmlWebpackPlugin.options.nodeModules.replace(/\\/g, "\\\\") %>')
    </script>
    <% } %>
</head>

<body>
  <div id="app"></div>
  <!-- webpack 构建会自动注入打包后的 js -->
</body>

</html>
