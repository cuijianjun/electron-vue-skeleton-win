{
  "name": "electron-vue-skeleton",
  "version": "1.0.0",
  "author": "your-name <your-email@example.com>",
  "description": "Electron + Vue 3 + Vite desktop skeleton (Windows)",
  "license": "MIT",
  "main": "dist/electron/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build": "npm run build:win64",
    "build:prod": "npm run build:win64",
    "build:test": "electron-vite build --mode test",
    "build:win64": "node scripts/build.cjs --platform win32 --arch x64",
    "build:win32": "node scripts/build.cjs --platform win32 --arch ia32",
    "build:dir": "node scripts/build.cjs --phase dir",
    "build:clean": "node scripts/clean.cjs",
    "pack:resources": "node scripts/pack-resources.cjs",
    "update:serve": "node server/index.js",
    "test:unit": "node --test test/unit/*.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test:dev": "node --test test/e2e/hmr.cjs",
    "test:packaged": "node --test test/e2e/packaged.cjs",
    "start": "electron-vite preview",
    "test:windows": "node --test test/e2e/windows-installer.cjs",
    "pack:dir": "node scripts/build.cjs --phase dir --skip-build",
    "pack:release": "node scripts/build.cjs --skip-build",
    "build:compact": "node scripts/build.cjs --compact"
  },
  "build": {
    "asar": true,
    "compression": "store",
    "productName": "myapp",
    "appId": "com.example.myapp",
    "executableName": "myapp",
    "protocols": [
      {
        "name": "myapp",
        "schemes": [
          "myapp"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "static/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.4.0",
    "builder-util-runtime": "9.7.0",
    "electron-log": "^5.4.0",
    "electron-store": "8.0.1",
    "electron-updater": "6.8.11",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "3.5.45",
    "autoprefixer": "10.6.2",
    "dotenv": "16.6.1",
    "electron": "44.7.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "express": "4.22.2",
    "playwright": "1.65.0",
    "sass": "1.100.0",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-router": "4.6.4",
    "vuex": "4.1.0"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "homepage": "https://electron-vite.org"
}
