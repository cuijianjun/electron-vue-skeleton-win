{
  "name": "electron-vue-skeleton",
  "version": "1.0.0",
  "author": "your-name <your-email@example.com>",
  "description": "Electron + Vue2 桌面应用骨架（Windows 版），含热更新 / 全量更新 / 增量更新能力",
  "license": "MIT",
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev": "cross-env TERGET_ENV=development node .electron-vue/dev-runner.js",
    "build": "cross-env BUILD_TARGET=clean TERGET_ENV=production node .electron-vue/build.js && electron-builder",
    "build:prod": "cross-env BUILD_TARGET=clean TERGET_ENV=production node .electron-vue/build.js && electron-builder",
    "build:test": "cross-env BUILD_TARGET=clean TERGET_ENV=test node .electron-vue/build.js && electron-builder",
    "build:win32": "cross-env BUILD_TARGET=clean node .electron-vue/build.js && electron-builder --win --ia32",
    "build:win64": "cross-env BUILD_TARGET=clean node .electron-vue/build.js && electron-builder --win --x64",
    "build:dir": "cross-env BUILD_TARGET=clean node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=onlyClean TERGET_ENV=production node .electron-vue/build.js",
    "pack:resources": "node .electron-vue/hot-updater.js",
    "update:serve": "node server/index.js",
    "postinstall": "electron-builder install-app-deps",
    "build-icon": "electron-icon-builder --input=./build/icons/icon.png --output=build/icons"
  },
  "build": {
    "asar": false,
    "compression": "store",
    "productName": "myapp",
    "appId": "com.example.myapp",
    "executableName": "myapp",
    "protocols": [
      {
        "name": "myapp",
        "schemes": [
          "myapp"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://your-update-server:8888/packageUpload",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*",
      "!dist/electron/**/*.map",
      "!dist/electron/**/node_modules/.cache",
      "!dist/electron/**/*.log",
      "!dist/electron/**/*.md",
      "!dist/electron/**/README*",
      "!dist/electron/**/CHANGELOG*",
      "!dist/electron/**/.git*"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "static/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.4.0",
    "electron-log": "^5.4.0",
    "electron-store": "8.0.1",
    "electron-updater": "^5.3.0",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.1.0",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.22.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.22.5",
    "@babel/plugin-proposal-do-expressions": "^7.22.5",
    "@babel/plugin-proposal-export-default-from": "^7.22.5",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-function-bind": "^7.22.5",
    "@babel/plugin-proposal-function-sent": "^7.22.5",
    "@babel/plugin-proposal-json-strings": "^7.18.6",
    "@babel/plugin-proposal-logical-assignment-operators": "^7.20.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-pipeline-operator": "^7.22.5",
    "@babel/plugin-proposal-throw-expressions": "^7.22.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "@babel/runtime": "^7.22.5",
    "babel-loader": "^9.1.2",
    "babel-plugin-transform-vue-jsx": "^4.0.1",
    "cfonts": "^2.10.0",
    "chalk": "^4.1.2",
    "copy-webpack-plugin": "^11.0.0",
    "core-js": "^3.31.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "del": "^6.1.1",
    "dotenv": "^16.3.1",
    "electron": "^21.4.4",
    "electron-builder": "^22.0.0",
    "esbuild-loader": "^3.2.0",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-html": "^6.2.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.3.1",
    "eslint-plugin-standard": "^5.0.0",
    "express": "4.18.2",
    "html-webpack-plugin": "^5.5.3",
    "listr2": "^5.0.7",
    "mini-css-extract-plugin": "2.7.6",
    "minimist": "^1.2.8",
    "node-loader": "^2.0.0",
    "portfinder": "^1.0.32",
    "postcss": "^8.4.24",
    "postcss-loader": "^7.3.3",
    "sass": "1.32.13",
    "sass-loader": "^13.3.2",
    "svg-sprite-loader": "^6.0.11",
    "terser-webpack-plugin": "^5.3.9",
    "url-loader": "^4.1.1",
    "vue": "^2.7.14",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "15.10.1",
    "vue-router": "^3.6.5",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.14",
    "vuex": "^3.6.0",
    "webpack": "^5.88.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-hot-middleware": "^2.25.4",
    "webpack-merge": "5.8.0"
  }
}
